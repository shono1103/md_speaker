{
  "name": "md-speaker",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Read only mdts .markdown-body with AivisSpeech from a selected heading",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-metadata.mjs",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vite-plugin-monkey": "^7.1.9",
    "vitest": "^4.1.10"
  }
}
